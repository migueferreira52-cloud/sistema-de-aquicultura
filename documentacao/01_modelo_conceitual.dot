digraph G {
graph [rankdir=LR, bgcolor="white", pad="0.30", nodesep="0.38", ranksep="0.95", splines=polyline, labelloc=t, label="MODELO CONCEITUAL  |  AQUICULTURA\nEntidades • atributos • relacionamentos • cardinalidades (mínimo, máximo)", fontname="DejaVu Sans", fontsize=22, dpi=175, outputorder=edgesfirst];
node [shape=plain, fontname="DejaVu Sans", fontsize=12];
edge [fontname="DejaVu Sans", fontsize=10, color="#667785", fontcolor="#243c4c", dir=none, penwidth=1.0, labeldistance=1.7, labelangle=25];
especies [label=<<TABLE BORDER="1" COLOR="#466477" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="white"><TR><TD COLSPAN="1" BGCOLOR="#e8eef2"><B>ESPÉCIES</B></TD></TR><TR><TD ALIGN="LEFT"><U>id</U></TD></TR><TR><TD ALIGN="LEFT">nome comum</TD></TR><TR><TD ALIGN="LEFT">nome cientifico</TD></TR><TR><TD ALIGN="LEFT">tipo</TD></TR><TR><TD ALIGN="LEFT">temperatura</TD></TR><TR><TD ALIGN="LEFT">ph</TD></TR><TR><TD ALIGN="LEFT">observacoes</TD></TR></TABLE>>];
tanques [label=<<TABLE BORDER="1" COLOR="#466477" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="white"><TR><TD COLSPAN="1" BGCOLOR="#e8eef2"><B>TANQUES</B></TD></TR><TR><TD ALIGN="LEFT"><U>id</U></TD></TR><TR><TD ALIGN="LEFT">identificacao</TD></TR><TR><TD ALIGN="LEFT">tipo</TD></TR><TR><TD ALIGN="LEFT">volume</TD></TR><TR><TD ALIGN="LEFT">profundidade</TD></TR><TR><TD ALIGN="LEFT">status</TD></TR><TR><TD ALIGN="LEFT">localizacao</TD></TR></TABLE>>];
fornecedores [label=<<TABLE BORDER="1" COLOR="#466477" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="white"><TR><TD COLSPAN="1" BGCOLOR="#e8eef2"><B>FORNECEDORES</B></TD></TR><TR><TD ALIGN="LEFT"><U>id</U></TD></TR><TR><TD ALIGN="LEFT">razao social</TD></TR><TR><TD ALIGN="LEFT">tipo documento</TD></TR><TR><TD ALIGN="LEFT">documento</TD></TR><TR><TD ALIGN="LEFT">tipo contato</TD></TR><TR><TD ALIGN="LEFT">contato</TD></TR><TR><TD ALIGN="LEFT">tipo insumo</TD></TR><TR><TD ALIGN="LEFT">endereco</TD></TR><TR><TD ALIGN="LEFT">observacoes</TD></TR></TABLE>>];
funcionarios [label=<<TABLE BORDER="1" COLOR="#466477" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="white"><TR><TD COLSPAN="1" BGCOLOR="#e8eef2"><B>FUNCIONÁRIOS</B></TD></TR><TR><TD ALIGN="LEFT"><U>id</U></TD></TR><TR><TD ALIGN="LEFT">nome</TD></TR><TR><TD ALIGN="LEFT">cpf</TD></TR><TR><TD ALIGN="LEFT">cargo</TD></TR><TR><TD ALIGN="LEFT">telefone</TD></TR><TR><TD ALIGN="LEFT">email</TD></TR><TR><TD ALIGN="LEFT">situacao</TD></TR><TR><TD ALIGN="LEFT">observacoes</TD></TR></TABLE>>];
clientes [label=<<TABLE BORDER="1" COLOR="#466477" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="white"><TR><TD COLSPAN="1" BGCOLOR="#e8eef2"><B>CLIENTES</B></TD></TR><TR><TD ALIGN="LEFT"><U>id</U></TD></TR><TR><TD ALIGN="LEFT">nome</TD></TR></TABLE>>];
equipamentos [label=<<TABLE BORDER="1" COLOR="#466477" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="white"><TR><TD COLSPAN="1" BGCOLOR="#e8eef2"><B>EQUIPAMENTOS</B></TD></TR><TR><TD ALIGN="LEFT"><U>id</U></TD></TR><TR><TD ALIGN="LEFT">nome</TD></TR></TABLE>>];
lotes [label=<<TABLE BORDER="1" COLOR="#466477" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="white"><TR><TD COLSPAN="1" BGCOLOR="#e8eef2"><B>LOTES</B></TD></TR><TR><TD ALIGN="LEFT"><U>id</U></TD></TR><TR><TD ALIGN="LEFT">codigo</TD></TR><TR><TD ALIGN="LEFT">data alojamento</TD></TR><TR><TD ALIGN="LEFT">quantidade</TD></TR><TR><TD ALIGN="LEFT">peso medio</TD></TR><TR><TD ALIGN="LEFT">origem</TD></TR><TR><TD ALIGN="LEFT">observacoes</TD></TR></TABLE>>];
alimentacao [label=<<TABLE BORDER="1" COLOR="#466477" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="white"><TR><TD COLSPAN="1" BGCOLOR="#e8eef2"><B>PLANO DE ALIMENTAÇÃO</B></TD></TR><TR><TD ALIGN="LEFT"><U>id</U></TD></TR><TR><TD ALIGN="LEFT">racao</TD></TR><TR><TD ALIGN="LEFT">percentual biomassa</TD></TR><TR><TD ALIGN="LEFT">frequencia</TD></TR><TR><TD ALIGN="LEFT">observacoes</TD></TR></TABLE>>];
registro_alimentacao [label=<<TABLE BORDER="1" COLOR="#466477" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="white"><TR><TD COLSPAN="1" BGCOLOR="#e8eef2"><B>REGISTRO DE ALIMENTAÇÃO</B></TD></TR><TR><TD ALIGN="LEFT"><U>id</U></TD></TR><TR><TD ALIGN="LEFT">data</TD></TR><TR><TD ALIGN="LEFT">quantidade</TD></TR><TR><TD ALIGN="LEFT">horario</TD></TR><TR><TD ALIGN="LEFT">observacoes</TD></TR></TABLE>>];
qualidade_agua [label=<<TABLE BORDER="1" COLOR="#466477" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="white"><TR><TD COLSPAN="1" BGCOLOR="#e8eef2"><B>QUALIDADE DA ÁGUA</B></TD></TR><TR><TD ALIGN="LEFT"><U>id</U></TD></TR><TR><TD ALIGN="LEFT">datahora</TD></TR><TR><TD ALIGN="LEFT">temperatura</TD></TR><TR><TD ALIGN="LEFT">ph</TD></TR><TR><TD ALIGN="LEFT">oxigenio</TD></TR><TR><TD ALIGN="LEFT">amonia</TD></TR><TR><TD ALIGN="LEFT">nitrito</TD></TR><TR><TD ALIGN="LEFT">nitrato</TD></TR><TR><TD ALIGN="LEFT">observacoes</TD></TR></TABLE>>];
tratamentos [label=<<TABLE BORDER="1" COLOR="#466477" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="white"><TR><TD COLSPAN="1" BGCOLOR="#e8eef2"><B>TRATAMENTOS</B></TD></TR><TR><TD ALIGN="LEFT"><U>id</U></TD></TR><TR><TD ALIGN="LEFT">data</TD></TR><TR><TD ALIGN="LEFT">diagnostico</TD></TR><TR><TD ALIGN="LEFT">medicamento</TD></TR><TR><TD ALIGN="LEFT">dosagem</TD></TR><TR><TD ALIGN="LEFT">duracao</TD></TR><TR><TD ALIGN="LEFT">carencia</TD></TR><TR><TD ALIGN="LEFT">observacoes</TD></TR></TABLE>>];
mortalidade [label=<<TABLE BORDER="1" COLOR="#466477" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="white"><TR><TD COLSPAN="1" BGCOLOR="#e8eef2"><B>MORTALIDADE</B></TD></TR><TR><TD ALIGN="LEFT"><U>id</U></TD></TR><TR><TD ALIGN="LEFT">data</TD></TR><TR><TD ALIGN="LEFT">quantidade</TD></TR><TR><TD ALIGN="LEFT">suspeita</TD></TR><TR><TD ALIGN="LEFT">destinacao</TD></TR><TR><TD ALIGN="LEFT">observacoes</TD></TR></TABLE>>];
manutencoes [label=<<TABLE BORDER="1" COLOR="#466477" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="white"><TR><TD COLSPAN="1" BGCOLOR="#e8eef2"><B>MANUTENÇÕES</B></TD></TR><TR><TD ALIGN="LEFT"><U>id</U></TD></TR><TR><TD ALIGN="LEFT">data</TD></TR><TR><TD ALIGN="LEFT">tipo</TD></TR><TR><TD ALIGN="LEFT">descricao</TD></TR><TR><TD ALIGN="LEFT">custo</TD></TR><TR><TD ALIGN="LEFT">proxima manutencao</TD></TR></TABLE>>];
vendas [label=<<TABLE BORDER="1" COLOR="#466477" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="white"><TR><TD COLSPAN="1" BGCOLOR="#e8eef2"><B>VENDAS</B></TD></TR><TR><TD ALIGN="LEFT"><U>id</U></TD></TR><TR><TD ALIGN="LEFT">data</TD></TR><TR><TD ALIGN="LEFT">documento</TD></TR><TR><TD ALIGN="LEFT">observacoes</TD></TR></TABLE>>];
itens_venda [label=<<TABLE BORDER="1" COLOR="#466477" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="white"><TR><TD COLSPAN="1" BGCOLOR="#e8eef2"><B>ITENS DA VENDA</B></TD></TR><TR><TD ALIGN="LEFT"><U>id</U></TD></TR><TR><TD ALIGN="LEFT">quantidade</TD></TR><TR><TD ALIGN="LEFT">unidade</TD></TR><TR><TD ALIGN="LEFT">preco</TD></TR></TABLE>>];
r_equipamentos_tanque_id [shape=diamond, style=filled, fillcolor="white", color="#667785", fontsize=10, margin="0.05", label="abriga"];
tanques -> r_equipamentos_tanque_id [taillabel="(0,1)"]; r_equipamentos_tanque_id -> equipamentos [headlabel="(0,n)"];
r_lotes_especie_id [shape=diamond, style=filled, fillcolor="white", color="#667785", fontsize=10, margin="0.05", label="classifica"];
especies -> r_lotes_especie_id [taillabel="(1,1)"]; r_lotes_especie_id -> lotes [headlabel="(0,n)"];
r_lotes_tanque_id [shape=diamond, style=filled, fillcolor="white", color="#667785", fontsize=10, margin="0.05", label="recebe"];
tanques -> r_lotes_tanque_id [taillabel="(1,1)"]; r_lotes_tanque_id -> lotes [headlabel="(0,n)"];
r_lotes_fornecedor_id [shape=diamond, style=filled, fillcolor="white", color="#667785", fontsize=10, margin="0.05", label="fornece"];
fornecedores -> r_lotes_fornecedor_id [taillabel="(0,1)"]; r_lotes_fornecedor_id -> lotes [headlabel="(0,n)"];
r_alimentacao_lote_id [shape=diamond, style=filled, fillcolor="white", color="#667785", fontsize=10, margin="0.05", label="possui plano"];
lotes -> r_alimentacao_lote_id [taillabel="(1,1)"]; r_alimentacao_lote_id -> alimentacao [headlabel="(0,n)"];
r_registro_alimentacao_alimentacao_id [shape=diamond, style=filled, fillcolor="white", color="#667785", fontsize=10, margin="0.05", label="orienta"];
alimentacao -> r_registro_alimentacao_alimentacao_id [taillabel="(1,1)"]; r_registro_alimentacao_alimentacao_id -> registro_alimentacao [headlabel="(0,n)"];
r_registro_alimentacao_funcionario_id [shape=diamond, style=filled, fillcolor="white", color="#667785", fontsize=10, margin="0.05", label="registra"];
funcionarios -> r_registro_alimentacao_funcionario_id [taillabel="(0,1)"]; r_registro_alimentacao_funcionario_id -> registro_alimentacao [headlabel="(0,n)"];
r_qualidade_agua_tanque_id [shape=diamond, style=filled, fillcolor="white", color="#667785", fontsize=10, margin="0.05", label="é monitorado"];
tanques -> r_qualidade_agua_tanque_id [taillabel="(1,1)"]; r_qualidade_agua_tanque_id -> qualidade_agua [headlabel="(0,n)"];
r_qualidade_agua_funcionario_id [shape=diamond, style=filled, fillcolor="white", color="#667785", fontsize=10, margin="0.05", label="mede"];
funcionarios -> r_qualidade_agua_funcionario_id [taillabel="(0,1)"]; r_qualidade_agua_funcionario_id -> qualidade_agua [headlabel="(0,n)"];
r_tratamentos_lote_id [shape=diamond, style=filled, fillcolor="white", color="#667785", fontsize=10, margin="0.05", label="recebe"];
lotes -> r_tratamentos_lote_id [taillabel="(1,1)"]; r_tratamentos_lote_id -> tratamentos [headlabel="(0,n)"];
r_tratamentos_funcionario_id [shape=diamond, style=filled, fillcolor="white", color="#667785", fontsize=10, margin="0.05", label="realiza"];
funcionarios -> r_tratamentos_funcionario_id [taillabel="(0,1)"]; r_tratamentos_funcionario_id -> tratamentos [headlabel="(0,n)"];
r_mortalidade_lote_id [shape=diamond, style=filled, fillcolor="white", color="#667785", fontsize=10, margin="0.05", label="apresenta"];
lotes -> r_mortalidade_lote_id [taillabel="(1,1)"]; r_mortalidade_lote_id -> mortalidade [headlabel="(0,n)"];
r_mortalidade_funcionario_id [shape=diamond, style=filled, fillcolor="white", color="#667785", fontsize=10, margin="0.05", label="registra"];
funcionarios -> r_mortalidade_funcionario_id [taillabel="(0,1)"]; r_mortalidade_funcionario_id -> mortalidade [headlabel="(0,n)"];
r_manutencoes_funcionario_id [shape=diamond, style=filled, fillcolor="white", color="#667785", fontsize=10, margin="0.05", label="realiza"];
funcionarios -> r_manutencoes_funcionario_id [taillabel="(0,1)"]; r_manutencoes_funcionario_id -> manutencoes [headlabel="(0,n)"];
r_manutencoes_tanque_id [shape=diamond, style=filled, fillcolor="white", color="#667785", fontsize=10, margin="0.05", label="recebe"];
tanques -> r_manutencoes_tanque_id [taillabel="(0,1)"]; r_manutencoes_tanque_id -> manutencoes [headlabel="(0,n)"];
r_manutencoes_equipamento_id [shape=diamond, style=filled, fillcolor="white", color="#667785", fontsize=10, margin="0.05", label="recebe"];
equipamentos -> r_manutencoes_equipamento_id [taillabel="(0,1)"]; r_manutencoes_equipamento_id -> manutencoes [headlabel="(0,n)"];
r_vendas_cliente_id [shape=diamond, style=filled, fillcolor="white", color="#667785", fontsize=10, margin="0.05", label="realiza"];
clientes -> r_vendas_cliente_id [taillabel="(1,1)"]; r_vendas_cliente_id -> vendas [headlabel="(0,n)"];
r_itens_venda_venda_id [shape=diamond, style=filled, fillcolor="white", color="#667785", fontsize=10, margin="0.05", label="contém"];
vendas -> r_itens_venda_venda_id [taillabel="(1,1)"]; r_itens_venda_venda_id -> itens_venda [headlabel="(0,n)"];
r_itens_venda_lote_id [shape=diamond, style=filled, fillcolor="white", color="#667785", fontsize=10, margin="0.05", label="compõe"];
lotes -> r_itens_venda_lote_id [taillabel="(1,1)"]; r_itens_venda_lote_id -> itens_venda [headlabel="(0,n)"];
}