digraph G {
graph [bgcolor="white", pad="0.35", rankdir=LR, nodesep=0.65, ranksep=0.75, labelloc=t, label="DIAGRAMA DE CLASSES / UML  |  AQUICULTURA\nClasse implementada e suas dependências", fontname="DejaVu Sans", fontsize=21, dpi=175];
node [fontname="DejaVu Sans", fontsize=12, shape=record, color="#466477", style=filled, fillcolor="#f3f6f8", margin="0.18,0.12"];
edge [fontname="DejaVu Sans", fontsize=11, color="#667785", style=dashed, arrowhead=open];
flask [label="«módulo»\napp.py / Flask\nrotas e funções", shape=box];
dao [label="{{CadastroDAO|+ tabela : str|+ __init__(tabela)\l+ listar()\l+ cadastrar(dados)\l}}"];
campos [label="«módulo»\ncampos.py\nCAMPOS", shape=box];
mysql [label="«banco de dados»\naquicultura_escolar",shape=cylinder];
con [label="«função»\nconectar() / PyMySQL",shape=box];
flask -> dao [label="usa"];
flask -> campos [label="valida"];
dao -> campos [label="consulta campos"];
dao -> con [label="utiliza"];
con -> mysql [label="conecta"];
}